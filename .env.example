# CivicSync Environment Configuration Example
# Copy this file to .env and fill in the values

# 1. Supabase Credentials (Required)
# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key is used ONLY for offline CLI database seeding and migrations (never in UI!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. AI Assistant (Gemini)
# From https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Platform Admin Passcode Barrier
# Secret passcode required to perform administrative approvals in Admin Portal
ADMIN_ACCESS_KEY=civicsync-admin-secret-2026

# 4. Demo Accounts Credentials (For seamless hackathon judging shortcuts)
DEMO_RESIDENT_EMAIL=resident@civicsync.demo
DEMO_RESIDENT_PASSWORD=DemoResident#2026

DEMO_GCC_EMAIL=authority.gcc@civicsync.demo
DEMO_GCC_PASSWORD=DemoAuthority#GCC2026

DEMO_CMWSSB_EMAIL=authority.cmwssb@civicsync.demo
DEMO_CMWSSB_PASSWORD=DemoAuthority#CMWSSB2026

DEMO_ADMIN_EMAIL=admin@civicsync.demo
DEMO_ADMIN_PASSWORD=DemoAdmin#Platform2026

# 5. Routing Service (Optional Stretch Goal)
# From https://openrouteservice.org
OPENROUTESERVICE_API_KEY=
